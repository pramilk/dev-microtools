{
  // Cloudflare Workers static-assets deployment.
  //
  // The site is fully static (`output: 'static'` in astro.config.mjs), so no
  // @astrojs/cloudflare adapter is needed — `astro build` writes plain files to
  // dist/ and Workers serves them directly for every route except the one below.
  //
  // Deploy to production: npx wrangler deploy         -> devmicrotools.com
  // Deploy to staging:    npx wrangler deploy --env staging -> staging.devmicrotools.com
  // Preview with:         npx wrangler dev
  //
  // Staging is a separate Worker (dev-microtools-s) on its own custom domain,
  // so it never touches production traffic.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dev-microtools",
  "compatibility_date": "2026-08-22",
  // `main` + `run_worker_first` add real per-request compute to this site for the first
  // time — src/worker/index.ts injects the "Network request" signals (IP, Cloudflare's
  // geo/ASN lookup, and the request's own headers) into the Browser Fingerprint
  // Inspector's HTML before it's returned, so the tool can show what the server saw on
  // the very request that loaded the page, without an extra fetch. `run_worker_first` is
  // an array, not `true`, precisely so this stays scoped to that one route: every other
  // page on the site still bypasses the Worker entirely and is served as a plain static
  // asset, same as before this was added.
  "main": "src/worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Serve /tools/foo/ from /tools/foo/index.html, matching Astro's
    // trailingSlash: 'always' + build.format: 'directory' output.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/browser-fingerprint-inspector/*"]
  },
  // Only the apex is bound to this Worker. www is NOT a route here on purpose.
  //
  // www.devmicrotools.com is a redirect-only hostname: it has a proxied A record
  // pointing at 192.0.2.1 (a reserved documentation IP that routes nowhere), and a
  // zone-level Redirect Rule (Rules -> Redirect Rules, "Redirect from WWW to root")
  // 301s it to the apex, preserving path and query string. The record exists purely
  // so requests reach Cloudflare edge where the rule can act on them -- nothing is
  // ever served from it, and www never reaches this Worker.
  //
  // Do NOT add www back as a custom_domain. Doing so makes wrangler re-provision the
  // hostname and overwrite that A record, which breaks the redirect. Equally, do not
  // delete the A record: without it www is NXDOMAIN and the Redirect Rule never fires,
  // because a rule can only run on traffic that resolves to Cloudflare in the first place.
  //
  // The redirect cannot live in this repo: a static-assets `_redirects` file matches on
  // path only and cannot match a hostname, and unlike the scoped `run_worker_first` route
  // above, a host-based redirect would need to run in front of every route on every
  // hostname — exactly the everything-goes-through-the-Worker cost this file avoids.
  "routes": [
    { "pattern": "devmicrotools.com", "custom_domain": true }
  ],
  "env": {
    "staging": {
      "name": "dev-microtools-s",
      "routes": [
        { "pattern": "staging.devmicrotools.com", "custom_domain": true }
      ]
    }
  }
}

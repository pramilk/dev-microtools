# build output
dist/
# Wrangler local dev-server state (miniflare cache/sqlite, deploy tmp files) — machine-local,
# regenerated by `wrangler dev`/`wrangler deploy`, never meant to be committed.
.wrangler/
# Playwright output: HTML report, traces and per-test artefacts.
/playwright-report/
/test-results/
/blob-report/
/.playwright/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# AI coding agent tooling — local/per-machine, not shared project config.
# Claude Code local session/tool state (settings.local.json, etc.), and its own
# project-instructions file — kept local rather than shared via git.
.claude/
CLAUDE.md
# Engineering-conventions doc aimed at AI coding agents — kept local rather than shared via git.
AGENTS.md
# MCP server config (e.g. the Playwright MCP entry) — local tool setup, not shared config.
.mcp.json
# Playwright MCP screenshots/snapshots
.playwright-mcp/
# Ad-hoc verification screenshots saved with a bare filename (no directory prefix) land
# in the repo root instead of .playwright-mcp/ above — ignore any image file at root,
# never inside public/, src/, or test-assets/, which this doesn't match.
/*.png
/*.jpg
/*.jpeg

# internal assests
.assets/

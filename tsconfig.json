{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    // Route JSX through Preact rather than React, so `class`, `onInput` and the
    // rest of Preact's DOM typings resolve correctly in the island components.
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "types": ["vitest/globals"]
  }
}

---
// A three-state theme control (system -> light -> dark -> system).
// Deliberately a tiny inline script rather than a Preact island: it is a few lines
// of DOM work and does not justify shipping a component framework to every page.
---

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  aria-label="Change colour theme"
  title="Change colour theme"
>
  <span class="theme-toggle__icon" data-theme-icon aria-hidden="true">◐</span>
  <span class="sr-only" data-theme-label>System theme</span>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.125rem;
    height: 2.125rem;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text-muted);
    cursor: pointer;
    font-size: 0.95rem;
    line-height: 1;
    transition:
      background-color 0.12s ease,
      color 0.12s ease,
      border-color 0.12s ease;
  }

  .theme-toggle:hover {
    background: var(--surface-2);
    color: var(--text);
    border-color: var(--text-subtle);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  // The behaviour lives in src/lib/theme.ts so it can be unit-tested; an inline
  // <script> in a .astro file has no test harness. This file keeps the markup.
  import { initThemeToggle } from '../lib/theme';

  initThemeToggle();
</script>

---
import { SITE } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    {/* The full tool index used to be repeated here too, but it's already one click away
        via the sidebar on every page — duplicating it just made the footer huge. */}
    <div class="footer-meta">
      <p class="footer-note">
        Every tool on this site runs entirely in your browser. Nothing you paste is
        uploaded, logged, or sent to a server.
      </p>
      <ul class="footer-links">
        <li><a href="/about/">About</a></li>
        <li><a href="/privacy-policy/">Privacy</a></li>
        <li><a href={SITE.repoUrl}>Source on GitHub</a></li>
        <li>
          <a href={SITE.buyMeACoffeeUrl} target="_blank" rel="noopener noreferrer">
            <span aria-hidden="true">☕</span> Buy me a coffee
          </a>
        </li>
      </ul>
      <p class="footer-credit">
        Open source components: <code>diff</code> (BSD-3-Clause), <code>blueimp-md5</code>
        (MIT), <code>qrcode-generator</code> (MIT), <code>js-yaml</code> (MIT),
        <code>sql-formatter</code> (MIT), <code>terser</code> (BSD-2-Clause),
        <code>bcryptjs</code> (MIT), <code>compromise</code> (MIT),
        <code>gpt-tokenizer</code> (MIT), <code>onnxruntime-web</code> (MIT).
      </p>
      <p class="footer-copy">&copy; {year} {SITE.name}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--surface-2);
    margin-top: var(--space-8);
    padding-block: var(--space-6);
    font-size: var(--text-sm);
  }

  .footer-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .footer-note {
    color: var(--text-muted);
    /* No max-width: the old ch-based cap made sense back when this note shared a row with a
       wide tools column next to it, but now that the footer is single-column, it just forced
       an artificially narrow wrap regardless of how much real width was available. Letting it
       size off the actual container means it's one line on most screens and wraps only when
       the viewport genuinely is that narrow. */
  }

  .footer-links {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-credit,
  .footer-copy {
    color: var(--text-subtle);
    font-size: var(--text-xs);
  }

  .footer-credit code {
    font-size: 0.95em;
  }
</style>

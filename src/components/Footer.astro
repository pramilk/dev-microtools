---
import { getCollection } from 'astro:content';
import { SITE } from '../lib/site';

// Full tool index in the footer: every tool is reachable in one click from every
// page. This is both a usability win and how newly published tools get crawled fast.
const tools = (await getCollection('tools')).sort((a, b) => a.data.order - b.data.order);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <nav class="footer-tools" aria-label="All tools">
      <h2 class="footer-heading">All tools</h2>
      <ul class="footer-tools__list">
        {
          tools.map((tool) => (
            <li>
              <a href={`/${tool.id}/`}>{tool.data.title}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="footer-meta">
      <p class="footer-note">
        Every tool on this site runs entirely in your browser. Nothing you paste is
        uploaded, logged, or sent to a server.
      </p>
      <ul class="footer-links">
        <li><a href="/about/">About</a></li>
        <li><a href="/privacy-policy/">Privacy</a></li>
      </ul>
      <p class="footer-credit">
        Open source components: <code>diff</code> (BSD-3-Clause), <code>blueimp-md5</code>
        (MIT), <code>qrcode-generator</code> (MIT), <code>js-yaml</code> (MIT).
      </p>
      <p class="footer-copy">&copy; {year} {SITE.name}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--surface-2);
    margin-top: var(--space-8);
    padding-block: var(--space-6);
    font-size: var(--text-sm);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 52rem) {
    .site-footer__inner {
      grid-template-columns: 1.6fr 1fr;
      gap: var(--space-7);
    }
  }

  .footer-heading {
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-subtle);
    font-family: var(--font-mono);
    font-weight: 600;
    margin-bottom: var(--space-3);
  }

  .footer-tools__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: var(--space-2) var(--space-4);
  }

  .footer-tools__list a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .footer-tools__list a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .footer-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .footer-note {
    color: var(--text-muted);
    max-width: 40ch;
  }

  .footer-links {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-credit,
  .footer-copy {
    color: var(--text-subtle);
    font-size: var(--text-xs);
  }

  .footer-credit code {
    font-size: 0.95em;
  }
</style>

---
import { getCollection } from 'astro:content';
import { TOOL_ICONS, DEFAULT_TOOL_ICON } from '../lib/toolIcons';
import { CATEGORIES, CATEGORY_SLUGS } from '../lib/categories';

// Persistent, site-wide tool navigation. Static content (search + the categorised
// link list) is plain server-rendered HTML — only the filtering behaviour needs a
// script, and it is a few lines of vanilla DOM code, not a hydrated component.
const tools = (await getCollection('tools')).sort((a, b) => a.data.order - b.data.order);
// Section order comes from CATEGORIES, not tool.order — those only sort tools within
// a category, not the categories themselves.
const categories = CATEGORIES.filter((category) => tools.some((tool) => tool.data.category === category));
const currentPath = Astro.url.pathname;
---

<aside class="sidebar" id="tools-sidebar" aria-label="All tools">
  <div class="sidebar__inner">
    <div class="sidebar__search">
      <button
        type="button"
        class="sidebar__collapse"
        data-sidebar-toggle
        aria-label="Collapse tools sidebar"
        aria-controls="tools-sidebar"
        aria-expanded="true"
        title="Collapse sidebar"
      >
        <span aria-hidden="true">‹</span>
      </button>
      <label class="sr-only" for="sidebar-search">Search tools</label>
      <div class="sidebar__search-field">
        <input
          type="search"
          id="sidebar-search"
          class="sidebar__search-input"
          placeholder="Search tools…"
          autocomplete="off"
          data-sidebar-search
        />
        <kbd class="sidebar__search-kbd" aria-hidden="true" data-sidebar-search-kbd>Ctrl K</kbd>
        <button
          type="button"
          class="sidebar__search-clear"
          data-sidebar-search-clear
          aria-label="Clear search"
          title="Clear search"
        >
          ×
        </button>
      </div>
    </div>

    <nav class="sidebar__nav" data-sidebar-nav>
      <div class="sidebar__group" data-pinned-section hidden>
        <p class="sidebar__group-title">Pinned</p>
        <ul class="sidebar__list" data-pinned-list></ul>
      </div>
      {
        categories.map((category) => (
          <div class="sidebar__group" data-sidebar-group>
            <p class="sidebar__group-title">
              <a href={`/category/${CATEGORY_SLUGS[category]}/`}>{category}</a>
            </p>
            <ul class="sidebar__list">
              {tools
                .filter((tool) => tool.data.category === category)
                .map((tool) => {
                  const href = `/${tool.id}/`;
                  return (
                    <li
                      data-sidebar-item
                      data-tool-id={tool.id}
                      data-tool-name={tool.data.title.toLowerCase()}
                      data-tool-summary={tool.data.summary.toLowerCase()}
                      data-tool-category={category}
                    >
                      <a href={href} aria-current={currentPath === href ? 'page' : undefined}>
                        <span class="sidebar__icon" aria-hidden="true">{TOOL_ICONS[tool.id] ?? DEFAULT_TOOL_ICON}</span>
                        <span class="sidebar__label">{tool.data.title}</span>
                      </a>
                      <button
                        type="button"
                        class="sidebar__pin"
                        data-pin-toggle
                        data-tool-id={tool.id}
                        data-tool-title={tool.data.title}
                        aria-pressed="false"
                        aria-label={`Pin ${tool.data.title} to the top`}
                        title="Pin to top"
                      >
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <circle cx="12" cy="7" r="4.5" />
                          <path d="M12 11 15 20 9 20Z" />
                        </svg>
                      </button>
                    </li>
                  );
                })}
            </ul>
          </div>
        ))
      }
      <p class="sidebar__empty" data-sidebar-empty hidden>
        No tools match your search.
      </p>
    </nav>
  </div>
</aside>

{/*
  Visible only while the sidebar is collapsed (hidden via the `html[data-sidebar='open']`
  rule below) — a slim tab docked right at the panel's edge, since a fully collapsed
  sidebar has zero width and nothing left in it to click.
*/}
<button
  type="button"
  class="sidebar-tab"
  data-sidebar-toggle
  aria-label="Expand tools sidebar"
  aria-controls="tools-sidebar"
  aria-expanded="false"
  title="Expand sidebar"
>
  <span aria-hidden="true">›</span>
</button>

<div class="sidebar-backdrop" data-sidebar-backdrop></div>

<style>
  .sidebar {
    flex-shrink: 0;
    width: var(--sidebar-width);
    overflow: hidden;
    border-right: 1px solid var(--border);
    background: var(--surface);
    position: sticky;
    top: var(--header-height);
    height: calc(100vh - var(--header-height));
    transition: width 0.15s ease;
  }

  :global(html[data-sidebar='closed']) .sidebar {
    width: 0;
    border-right-color: transparent;
  }

  .sidebar__inner {
    width: var(--sidebar-width);
    height: 100%;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-4);
  }

  /* Sticky within `.sidebar__inner`'s own scroll area (not the page) — stays
     reachable while the tool list scrolls underneath it instead of scrolling
     away with the rest of the panel. */
  .sidebar__search {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-block: var(--space-1) var(--space-3);
    margin-block: calc(-1 * var(--space-1)) calc(-1 * var(--space-3));
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }

  .sidebar__collapse {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text-muted);
    cursor: pointer;
    font-size: 1.1rem;
    line-height: 1;
  }

  .sidebar__collapse:hover {
    background: var(--surface-2);
    color: var(--text);
    border-color: var(--text-subtle);
  }

  .sidebar__search-field {
    position: relative;
    flex: 1;
    min-width: 0;
  }

  .sidebar__search-input {
    width: 100%;
    height: 2.25rem;
    padding-inline: var(--space-3) 3.25rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--surface-2);
    color: var(--text);
    font-size: var(--text-sm);
    font-family: inherit;
  }

  .sidebar__search-input::placeholder {
    color: var(--text-subtle);
  }

  /* The native clear "x" a `type="search"` input draws on its own can't be
     repositioned, resized or given a hover state, and renders inconsistently across
     browsers — so it's suppressed here and replaced with `.sidebar__search-clear`,
     a real button styled like the rest of the site's icon controls. */
  .sidebar__search-input::-webkit-search-decoration,
  .sidebar__search-input::-webkit-search-cancel-button,
  .sidebar__search-input::-webkit-search-results-button,
  .sidebar__search-input::-webkit-search-results-decoration {
    appearance: none;
  }

  /* Hidden once the input has a query — the shortcut has already done its job, and
     the clear button (below) takes its place once there's something to clear. */
  .sidebar__search-kbd {
    position: absolute;
    top: 50%;
    right: var(--space-2);
    transform: translateY(-50%);
    padding: 0.15rem 0.4rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--text-subtle);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1.3;
    pointer-events: none;
    white-space: nowrap;
  }

  .sidebar__search-input:focus ~ .sidebar__search-kbd,
  .sidebar__search-input:not(:placeholder-shown) ~ .sidebar__search-kbd {
    display: none;
  }

  .sidebar__search-clear {
    display: none;
    align-items: center;
    justify-content: center;
    position: absolute;
    top: 50%;
    right: 0.2rem;
    transform: translateY(-50%);
    width: 1.85rem;
    height: 1.85rem;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: transparent;
    color: var(--text-subtle);
    cursor: pointer;
    font-size: 1.05rem;
    line-height: 1;
    transition:
      background-color 0.12s ease,
      color 0.12s ease;
  }

  .sidebar__search-clear:hover {
    background: var(--surface-3);
    color: var(--text);
  }

  .sidebar__search-clear:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 1px;
  }

  .sidebar__search-input:not(:placeholder-shown) ~ .sidebar__search-clear {
    display: inline-flex;
  }

  .sidebar__nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .sidebar__group-title {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-family: var(--font-mono);
    color: var(--text-subtle);
    font-weight: 600;
    margin-bottom: var(--space-2);
  }

  /* Links to that category's crawlable /category/<slug>/ landing page — see the matching
     comment on .group__title a in index.astro for why this stays styled as plain text. */
  .sidebar__group-title a {
    color: inherit;
    text-decoration: none;
  }

  .sidebar__group-title a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: var(--accent-border);
  }

  .sidebar__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .sidebar__list li {
    display: flex;
    align-items: center;
  }

  .sidebar__list a {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    flex: 1;
    min-width: 0;
    padding: var(--space-2) var(--space-3);
    border-left: 3px solid transparent;
    border-radius: var(--radius-sm);
    color: var(--text);
    font-weight: 500;
    text-decoration: none;
    font-size: var(--text-sm);
    transition:
      background-color 0.12s ease,
      border-color 0.12s ease,
      color 0.12s ease,
      transform 0.12s ease;
  }

  .sidebar__pin {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.6rem;
    height: 1.6rem;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: transparent;
    color: var(--text-subtle);
    cursor: pointer;
    opacity: 0.5;
    transition:
      opacity 0.12s ease,
      background-color 0.12s ease,
      color 0.12s ease;
  }

  .sidebar__pin:hover,
  .sidebar__pin:focus-visible {
    opacity: 1;
    background: var(--surface-3);
  }

  .sidebar__pin:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 1px;
  }

  .sidebar__pin[aria-pressed='true'] {
    opacity: 1;
    color: var(--accent);
  }

  .sidebar__pin svg {
    width: 0.75rem;
    height: 0.75rem;
    fill: currentColor;
    transform: rotate(45deg);
    transition: transform 0.15s ease;
  }

  .sidebar__pin[aria-pressed='true'] svg {
    transform: rotate(0deg);
  }

  /* A short coloured label rather than plain muted text — easier to scan down the
     list at a glance, while staying inside the single-accent-colour system (no
     per-tool colours, unlike the emoji this replaced). No filled background: a
     first pass used a solid badge chip here and it read as too heavy/loud next to
     the plain-text tool names — colour alone carries enough weight. */
  .sidebar__icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    min-width: 1.85rem;
    color: var(--accent);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    font-family: var(--font-mono);
    white-space: nowrap;
    /* 0.85 used to read fine but dropped light-mode contrast to ~4.24:1 against
       the page background — below WCAG AA's 4.5:1 for this small (10.88px) text.
       0.92 keeps a visible dimmed/active distinction while staying at ~4.9:1. */
    opacity: 0.92;
    transition: opacity 0.12s ease;
  }

  .sidebar__list a[aria-current='page'] .sidebar__icon,
  .sidebar__list a:hover .sidebar__icon {
    opacity: 1;
  }

  .sidebar__label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sidebar__list a:hover {
    background: var(--accent-subtle);
    border-left-color: var(--accent-border);
    color: var(--accent);
    transform: translateX(2px);
  }

  .sidebar__list a[aria-current='page'] {
    background: var(--accent-subtle);
    border-left-color: var(--accent);
    color: var(--accent);
    font-weight: 700;
  }

  /* Description-only search matches (the query didn't hit the title) are still
     shown, just visually secondary to direct title matches above them. */
  .sidebar__item--weak-match a {
    opacity: 0.7;
  }

  .sidebar__empty {
    font-size: var(--text-sm);
    color: var(--text-subtle);
    padding-inline: var(--space-3);
  }

  /* The expand tab sits right where the collapsed (width: 0) sidebar's edge is,
     so it reads as part of the panel rather than a header control disconnected
     from what it opens. Hidden once the sidebar itself is open — its own internal
     collapse button (above) takes over from there. */
  .sidebar-tab {
    flex-shrink: 0;
    align-self: flex-start;
    position: sticky;
    top: var(--header-height);
    width: 1.75rem;
    height: 2.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-left: none;
    border-radius: 0 var(--radius) var(--radius) 0;
    background: var(--surface);
    color: var(--accent);
    font-size: 1.05rem;
    box-shadow: var(--shadow-sm);
    cursor: pointer;
  }

  .sidebar-tab:hover {
    color: var(--accent-hover);
    background: var(--surface-2);
    box-shadow: var(--shadow);
  }

  :global(html[data-sidebar='open']) .sidebar-tab {
    display: none;
  }

  .sidebar-backdrop {
    display: none;
  }

  /* Below this width the sidebar becomes an off-canvas overlay (fixed + slide-in)
     instead of a flex column that squeezes the main content — matches the
     `min-width: 64rem` breakpoint BaseLayout's no-FOUC script uses to decide the
     default open/closed state, so there's no in-between range where opening the
     sidebar visibly squeezes a tool's controls into a sliver. */
  @media (max-width: 63.99rem) {
    .sidebar {
      position: fixed;
      inset: var(--header-height) auto 0 0;
      z-index: 30;
      width: min(85vw, 20rem);
      transform: translateX(-100%);
      transition: transform 0.15s ease;
      box-shadow: var(--shadow);
    }

    /* Taken out of the `.shell` flex row here too — left at `position: sticky` (its
       desktop value), this still reserved its own 1.75rem-plus-border column in the flex
       row permanently, on every mobile page, even though the sidebar it opens is already
       an off-canvas overlay with nothing left in the flow to share space with. That
       reserved strip was pure wasted width down the left edge of every tool. `position:
       fixed` floats it over the content instead, so `.shell__main` gets the full viewport
       width back — but docked to the top edge (its desktop position) it then floated
       straight on top of the breadcrumb row's "Home" link on every page, since a fixed
       element no longer pushes in-flow content aside the way its old flex-flow box did. A
       round floating button in the bottom-left corner, clear of any page content on every
       tool, avoids that regardless of how long or short a given page is. */
    .sidebar-tab {
      position: fixed;
      inset: auto auto var(--space-4) var(--space-4);
      z-index: 21;
      width: 2.75rem;
      height: 2.75rem;
      border: 1px solid var(--border-strong);
      border-radius: 50%;
      box-shadow: var(--shadow);
    }

    .sidebar__inner {
      width: 100%;
    }

    :global(html[data-sidebar='open']) .sidebar {
      transform: translateX(0);
    }

    :global(html[data-sidebar='closed']) .sidebar {
      width: min(85vw, 20rem);
      border-right-color: var(--border);
    }

    :global(html[data-sidebar='open']) .sidebar-backdrop {
      display: block;
      position: fixed;
      inset: var(--header-height) 0 0 0;
      background: rgb(0 0 0 / 40%);
      z-index: 29;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar {
      transition: none;
    }
  }
</style>

<script>
  // The behaviour lives in src/lib/sidebar.ts and src/lib/pinnedTools.ts so it can be
  // unit-tested; an inline <script> in a .astro file has no test harness, and the search
  // filter here is the largest piece of hand-written DOM code on the site. This file
  // keeps the markup.
  import { initSidebar } from '../lib/sidebar';
  import { initPinnedTools } from '../lib/pinnedTools';

  initSidebar();
  initPinnedTools();
</script>

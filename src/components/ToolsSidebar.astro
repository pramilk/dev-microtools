---
import { getCollection } from 'astro:content';
import { TOOL_ICONS, DEFAULT_TOOL_ICON } from '../lib/toolIcons';
import { CATEGORIES } from '../lib/categories';

// Persistent, site-wide tool navigation. Static content (search + the categorised
// link list) is plain server-rendered HTML — only the filtering behaviour needs a
// script, and it is a few lines of vanilla DOM code, not a hydrated component.
const tools = (await getCollection('tools')).sort((a, b) => a.data.order - b.data.order);
// Section order comes from CATEGORIES, not tool.order — those only sort tools within
// a category, not the categories themselves.
const categories = CATEGORIES.filter((category) => tools.some((tool) => tool.data.category === category));
const currentPath = Astro.url.pathname;
---

<aside class="sidebar" id="tools-sidebar" aria-label="All tools">
  <div class="sidebar__inner">
    <div class="sidebar__search">
      <button
        type="button"
        class="sidebar__collapse"
        data-sidebar-toggle
        aria-label="Collapse tools sidebar"
        aria-controls="tools-sidebar"
        aria-expanded="true"
        title="Collapse sidebar"
      >
        <span aria-hidden="true">‹</span>
      </button>
      <label class="sr-only" for="sidebar-search">Search tools</label>
      <div class="sidebar__search-field">
        <input
          type="search"
          id="sidebar-search"
          class="sidebar__search-input"
          placeholder="Search tools…"
          autocomplete="off"
          data-sidebar-search
        />
        <kbd class="sidebar__search-kbd" aria-hidden="true" data-sidebar-search-kbd>Ctrl K</kbd>
      </div>
    </div>

    <nav class="sidebar__nav" data-sidebar-nav>
      {
        categories.map((category) => (
          <div class="sidebar__group" data-sidebar-group>
            <p class="sidebar__group-title">{category}</p>
            <ul class="sidebar__list">
              {tools
                .filter((tool) => tool.data.category === category)
                .map((tool) => {
                  const href = `/${tool.id}/`;
                  return (
                    <li
                      data-sidebar-item
                      data-tool-name={tool.data.title.toLowerCase()}
                      data-tool-summary={tool.data.summary.toLowerCase()}
                    >
                      <a href={href} aria-current={currentPath === href ? 'page' : undefined}>
                        <span class="sidebar__icon" aria-hidden="true">{TOOL_ICONS[tool.id] ?? DEFAULT_TOOL_ICON}</span>
                        <span class="sidebar__label">{tool.data.title}</span>
                      </a>
                    </li>
                  );
                })}
            </ul>
          </div>
        ))
      }
      <p class="sidebar__empty" data-sidebar-empty hidden>
        No tools match your search.
      </p>
    </nav>
  </div>
</aside>

{/*
  Visible only while the sidebar is collapsed (hidden via the `html[data-sidebar='open']`
  rule below) — a slim tab docked right at the panel's edge, since a fully collapsed
  sidebar has zero width and nothing left in it to click.
*/}
<button
  type="button"
  class="sidebar-tab"
  data-sidebar-toggle
  aria-label="Expand tools sidebar"
  aria-controls="tools-sidebar"
  aria-expanded="false"
  title="Expand sidebar"
>
  <span aria-hidden="true">›</span>
</button>

<div class="sidebar-backdrop" data-sidebar-backdrop></div>

<style>
  .sidebar {
    flex-shrink: 0;
    width: var(--sidebar-width);
    overflow: hidden;
    border-right: 1px solid var(--border);
    background: var(--surface);
    position: sticky;
    top: var(--header-height);
    height: calc(100vh - var(--header-height));
    transition: width 0.15s ease;
  }

  :global(html[data-sidebar='closed']) .sidebar {
    width: 0;
    border-right-color: transparent;
  }

  .sidebar__inner {
    width: var(--sidebar-width);
    height: 100%;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-4);
  }

  /* Sticky within `.sidebar__inner`'s own scroll area (not the page) — stays
     reachable while the tool list scrolls underneath it instead of scrolling
     away with the rest of the panel. */
  .sidebar__search {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-block: var(--space-1) var(--space-3);
    margin-block: calc(-1 * var(--space-1)) calc(-1 * var(--space-3));
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }

  .sidebar__collapse {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text-muted);
    cursor: pointer;
    font-size: 1.1rem;
    line-height: 1;
  }

  .sidebar__collapse:hover {
    background: var(--surface-2);
    color: var(--text);
    border-color: var(--text-subtle);
  }

  .sidebar__search-field {
    position: relative;
    flex: 1;
    min-width: 0;
  }

  .sidebar__search-input {
    width: 100%;
    height: 2.25rem;
    padding-inline: var(--space-3) 3.25rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--surface-2);
    color: var(--text);
    font-size: var(--text-sm);
    font-family: inherit;
  }

  .sidebar__search-input::placeholder {
    color: var(--text-subtle);
  }

  /* Hidden once the input has a query or focus, since the shortcut has already done its
     job — showing "Ctrl K" over live search results would just be visual noise. */
  .sidebar__search-kbd {
    position: absolute;
    top: 50%;
    right: var(--space-2);
    transform: translateY(-50%);
    padding: 0.15rem 0.4rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--text-subtle);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1.3;
    pointer-events: none;
    white-space: nowrap;
  }

  .sidebar__search-input:focus ~ .sidebar__search-kbd,
  .sidebar__search-input:not(:placeholder-shown) ~ .sidebar__search-kbd {
    display: none;
  }

  .sidebar__nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .sidebar__group-title {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-family: var(--font-mono);
    color: var(--text-subtle);
    font-weight: 600;
    margin-bottom: var(--space-2);
  }

  .sidebar__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .sidebar__list a {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-2) var(--space-3);
    border-left: 3px solid transparent;
    border-radius: var(--radius-sm);
    color: var(--text);
    font-weight: 500;
    text-decoration: none;
    font-size: var(--text-sm);
    transition:
      background-color 0.12s ease,
      border-color 0.12s ease,
      color 0.12s ease,
      transform 0.12s ease;
  }

  /* A short coloured label rather than plain muted text — easier to scan down the
     list at a glance, while staying inside the single-accent-colour system (no
     per-tool colours, unlike the emoji this replaced). No filled background: a
     first pass used a solid badge chip here and it read as too heavy/loud next to
     the plain-text tool names — colour alone carries enough weight. */
  .sidebar__icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    min-width: 1.85rem;
    color: var(--accent);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    font-family: var(--font-mono);
    white-space: nowrap;
    opacity: 0.85;
    transition: opacity 0.12s ease;
  }

  .sidebar__list a[aria-current='page'] .sidebar__icon,
  .sidebar__list a:hover .sidebar__icon {
    opacity: 1;
  }

  .sidebar__label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sidebar__list a:hover {
    background: var(--accent-subtle);
    border-left-color: var(--accent-border);
    color: var(--accent);
    transform: translateX(2px);
  }

  .sidebar__list a[aria-current='page'] {
    background: var(--accent-subtle);
    border-left-color: var(--accent);
    color: var(--accent);
    font-weight: 700;
  }

  /* Description-only search matches (the query didn't hit the title) are still
     shown, just visually secondary to direct title matches above them. */
  .sidebar__item--weak-match a {
    opacity: 0.7;
  }

  .sidebar__empty {
    font-size: var(--text-sm);
    color: var(--text-subtle);
    padding-inline: var(--space-3);
  }

  /* The expand tab sits right where the collapsed (width: 0) sidebar's edge is,
     so it reads as part of the panel rather than a header control disconnected
     from what it opens. Hidden once the sidebar itself is open — its own internal
     collapse button (above) takes over from there. */
  .sidebar-tab {
    flex-shrink: 0;
    align-self: flex-start;
    position: sticky;
    top: var(--header-height);
    width: 1.75rem;
    height: 2.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-left: none;
    border-radius: 0 var(--radius) var(--radius) 0;
    background: var(--surface);
    color: var(--accent);
    font-size: 1.05rem;
    box-shadow: var(--shadow-sm);
    cursor: pointer;
  }

  .sidebar-tab:hover {
    color: var(--accent-hover);
    background: var(--surface-2);
    box-shadow: var(--shadow);
  }

  :global(html[data-sidebar='open']) .sidebar-tab {
    display: none;
  }

  .sidebar-backdrop {
    display: none;
  }

  /* Below this width the sidebar becomes an off-canvas overlay (fixed + slide-in)
     instead of a flex column that squeezes the main content — matches the
     `min-width: 64rem` breakpoint BaseLayout's no-FOUC script uses to decide the
     default open/closed state, so there's no in-between range where opening the
     sidebar visibly squeezes a tool's controls into a sliver. */
  @media (max-width: 63.99rem) {
    .sidebar {
      position: fixed;
      inset: var(--header-height) auto 0 0;
      z-index: 30;
      width: min(85vw, 20rem);
      transform: translateX(-100%);
      transition: transform 0.15s ease;
      box-shadow: var(--shadow);
    }

    .sidebar__inner {
      width: 100%;
    }

    :global(html[data-sidebar='open']) .sidebar {
      transform: translateX(0);
    }

    :global(html[data-sidebar='closed']) .sidebar {
      width: min(85vw, 20rem);
      border-right-color: var(--border);
    }

    :global(html[data-sidebar='open']) .sidebar-backdrop {
      display: block;
      position: fixed;
      inset: var(--header-height) 0 0 0;
      background: rgb(0 0 0 / 40%);
      z-index: 29;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar {
      transition: none;
    }
  }
</style>

<script>
  // Reads/writes the `data-sidebar` attribute BaseLayout's no-FOUC inline script
  // already applies before first paint — every open/close control on the page
  // (the internal collapse button, the external expand tab, the backdrop, Escape,
  // and picking a tool link on mobile) funnels through this one pair of functions.
  function currentlyOpen(): boolean {
    return document.documentElement.getAttribute('data-sidebar') === 'open';
  }

  function setOpen(open: boolean): void {
    document.documentElement.setAttribute('data-sidebar', open ? 'open' : 'closed');
    try {
      localStorage.setItem('sidebarOpen', open ? '1' : '0');
    } catch {
      // Persisting is best-effort; the sidebar still toggles for this page view.
    }
    for (const button of document.querySelectorAll<HTMLElement>('[data-sidebar-toggle]')) {
      button.setAttribute('aria-expanded', String(open));
    }
  }

  for (const button of document.querySelectorAll<HTMLElement>('[data-sidebar-toggle]')) {
    button.setAttribute('aria-expanded', String(currentlyOpen()));
    button.addEventListener('click', () => setOpen(!currentlyOpen()));
  }

  const input = document.querySelector<HTMLInputElement>('[data-sidebar-search]');
  const searchKbd = document.querySelector<HTMLElement>('[data-sidebar-search-kbd]');

  // Shows the platform-correct shortcut label — browsers reserve Ctrl+T/Cmd+T (new tab),
  // so Ctrl+K/Cmd+K is used instead, matching the convention GitHub/Linear/Slack/Vercel
  // all use for "focus site search".
  const isMac = /mac/i.test(
    (navigator as Navigator & { userAgentData?: { platform?: string } }).userAgentData?.platform ?? navigator.platform
  );
  if (searchKbd && isMac) searchKbd.textContent = '⌘ K';

  document.addEventListener('keydown', (event) => {
    if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      if (!currentlyOpen()) setOpen(true);
      input?.focus();
      input?.select();
    }
  });

  const items = document.querySelectorAll<HTMLLIElement>('[data-sidebar-item]');
  const groups = document.querySelectorAll<HTMLElement>('[data-sidebar-group]');
  const empty = document.querySelector<HTMLElement>('[data-sidebar-empty]');

  // Original (category, then `order`) DOM position of every item, so search can
  // freely reorder items to float better matches to the top and still put them
  // back exactly where they started once the query is cleared.
  const originalOrder = new Map<HTMLElement, HTMLLIElement[]>();
  for (const group of groups) {
    const list = group.querySelector<HTMLElement>('.sidebar__list');
    if (list) originalOrder.set(list, Array.from(list.querySelectorAll<HTMLLIElement>('[data-sidebar-item]')));
  }

  // Optimal-string-alignment edit distance (Levenshtein plus adjacent-transposition
  // as a single edit) so the single most common typo shape — two swapped letters,
  // e.g. "jsno" for "json" — counts as distance 1, not 2. Strings here are short
  // tool words over a small list, so the full O(n*m) table is cheap.
  function editDistance(a: string, b: string, max: number): number {
    if (Math.abs(a.length - b.length) > max) return max + 1;
    const m = a.length;
    const n = b.length;
    const d: number[][] = Array.from({ length: m + 1 }, () => new Array(n + 1).fill(0));
    for (let i = 0; i <= m; i++) d[i][0] = i;
    for (let j = 0; j <= n; j++) d[0][j] = j;
    for (let i = 1; i <= m; i++) {
      for (let j = 1; j <= n; j++) {
        const cost = a[i - 1] === b[j - 1] ? 0 : 1;
        d[i][j] = Math.min(d[i - 1][j] + 1, d[i][j - 1] + 1, d[i - 1][j - 1] + cost);
        if (i > 1 && j > 1 && a[i - 1] === b[j - 2] && a[i - 2] === b[j - 1]) {
          d[i][j] = Math.min(d[i][j], d[i - 2][j - 2] + 1);
        }
      }
    }
    return d[m][n];
  }

  // A search token matches a haystack if it's a plain substring (handles partial
  // words like "form" -> "formatter"), or, for tokens long enough that typos are
  // meaningful, if it's within a small edit distance of some word in the haystack
  // (so "regeex"/"csvv" still find "Regex Tester"/"CSV to JSON").
  function tokenMatches(token: string, haystack: string, words: string[]): boolean {
    if (haystack.includes(token)) return true;
    if (token.length < 4) return false;
    const maxDistance = token.length <= 5 ? 1 : 2;
    return words.some((word) => editDistance(token, word, maxDistance) <= maxDistance);
  }

  input?.addEventListener('input', () => {
    const query = input.value.trim().toLowerCase();
    const tokens = query.split(/\s+/).filter(Boolean);
    let anyVisible = false;

    for (const item of items) {
      const name = item.dataset.toolName ?? '';
      const summary = item.dataset.toolSummary ?? '';
      const haystack = `${name} ${summary}`;
      const words = haystack.split(/\s+/).filter(Boolean);

      // Every search word must match something (title or description) — order-
      // independent, so "converter unix" still finds "Unix Timestamp Converter".
      const match = tokens.length === 0 || tokens.every((token) => tokenMatches(token, haystack, words));
      item.hidden = !match;
      // Title hits outrank description-only hits so e.g. searching "json" surfaces
      // "JSON Formatter" before a tool whose summary merely mentions JSON in passing.
      item.classList.toggle(
        'sidebar__item--weak-match',
        match && tokens.length > 0 && !tokens.every((token) => name.includes(token))
      );
      if (match) anyVisible = true;
    }

    for (const group of groups) {
      const list = group.querySelector<HTMLElement>('.sidebar__list');
      const order = list ? originalOrder.get(list) : undefined;
      if (list && order) {
        if (tokens.length === 0) {
          // No query: restore the original order exactly, undoing any reorder
          // from a previous search.
          for (const item of order) list.appendChild(item);
        } else {
          // Float title matches above description-only matches within the group.
          const sorted = [...order].sort(
            (a, b) => Number(a.classList.contains('sidebar__item--weak-match')) - Number(b.classList.contains('sidebar__item--weak-match'))
          );
          for (const item of sorted) list.appendChild(item);
        }
      }
      group.hidden = order ? order.every((item) => item.hidden) : true;
    }

    if (empty) empty.hidden = anyVisible || query === '';
  });

  // Mobile only: clicking the backdrop or pressing Escape closes the overlay.
  const backdrop = document.querySelector<HTMLElement>('[data-sidebar-backdrop]');
  backdrop?.addEventListener('click', () => setOpen(false));

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && currentlyOpen()) setOpen(false);
  });

  // Picking a tool while the sidebar is an overlay (same breakpoint as the CSS
  // above) should close it — it's a full-page navigation either way, but without
  // this the sidebar would still be sitting open, covering the new page, until the
  // next full reload happens to pick up a "closed" default.
  const overlayBreakpoint = window.matchMedia('(max-width: 63.99rem)');
  for (const link of document.querySelectorAll<HTMLAnchorElement>('.sidebar__list a')) {
    link.addEventListener('click', () => {
      if (overlayBreakpoint.matches) setOpen(false);
    });
  }
</script>

---
import { getCollection } from 'astro:content';

interface Props {
  /** Slugs to link to. Unknown slugs are skipped rather than rendering dead links. */
  slugs: string[];
  currentSlug: string;
  /** Small pill links (name only) instead of full description cards — for placing
   * right after the widget, before the reader gets into the long-form description. */
  compact?: boolean;
}

const { slugs, currentSlug, compact = false } = Astro.props;

const all = await getCollection('tools');
const related = slugs
  .filter((slug) => slug !== currentSlug)
  .map((slug) => all.find((tool) => tool.id === slug))
  .filter((tool): tool is (typeof all)[number] => tool !== undefined);
---

{
  related.length > 0 &&
    (compact ? (
      <nav class="related related--compact" aria-labelledby="related-heading">
        <h2 id="related-heading" class="related__heading related__heading--compact">
          Related tools
        </h2>
        <ul class="related__pills">
          {related.map((tool) => (
            <li>
              <a href={`/${tool.id}/`} class="related__pill" title={tool.data.summary}>
                {tool.data.title}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ) : (
      <nav class="related" aria-labelledby="related-heading">
        <h2 id="related-heading" class="related__heading">
          Related tools
        </h2>
        <ul class="related__list">
          {related.map((tool) => (
            <li>
              <a href={`/${tool.id}/`} class="related__card">
                <span class="related__name">{tool.data.title}</span>
                <span class="related__summary">{tool.data.summary}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ))
}

<style>
  .related {
    margin-top: var(--space-7);
  }

  .related__heading {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-family: var(--font-mono);
    color: var(--text-subtle);
    font-weight: 600;
    margin-bottom: var(--space-3);
  }

  .related__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }

  .related__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    height: 100%;
    padding: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
    transition:
      border-color 0.12s ease,
      background-color 0.12s ease;
  }

  .related__card:hover {
    border-color: var(--accent);
    background: var(--surface-2);
  }

  .related__name {
    font-weight: 600;
    color: var(--text);
    font-size: var(--text-sm);
  }

  .related__card:hover .related__name {
    color: var(--accent);
  }

  .related__summary {
    font-size: var(--text-xs);
    color: var(--text-muted);
    line-height: 1.5;
  }

  .related--compact {
    margin-top: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }

  .related__heading--compact {
    margin-bottom: 0;
    white-space: nowrap;
  }

  .related__pills {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .related__pill {
    display: inline-flex;
    align-items: center;
    padding: 0.3rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 99px;
    background: var(--surface);
    color: var(--text-muted);
    font-size: var(--text-sm);
    text-decoration: none;
    transition:
      border-color 0.12s ease,
      color 0.12s ease,
      background-color 0.12s ease;
  }

  .related__pill:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-subtle);
  }
</style>

---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ToolsSidebar from '../components/ToolsSidebar.astro';
import BuyMeACoffee from '../components/BuyMeACoffee.astro';
import { SITE } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** Path-only canonical, e.g. "/json-formatter/". Defaults to the current URL. */
  canonicalPath?: string;
  /** JSON-LD objects to embed. Serialised into individual script tags. */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  /** Path to a page-specific social preview image, e.g. `/og/json-formatter.png`.
   *  Defaults to the site's generic `/og-image.png`. */
  ogImagePath?: string;
}

const { title, description, canonicalPath, schema = [], noindex = false, ogImagePath } = Astro.props;

const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site ?? SITE.url).href;
const fullTitle = title === SITE.name ? title : `${title} | ${SITE.name}`;
const ogImage = new URL(ogImagePath ?? '/og-image.png', Astro.site ?? SITE.url).href;

/**
 * `JSON.stringify` alone doesn't escape "</script" — FAQ copy that happens to mention a
 * literal `</script>` tag (as the HTML/CSS/JS minifier's does) would otherwise terminate
 * this script element early and spill the rest of the JSON as visible page text. `<` has
 * no special meaning in JSON, so escaping every occurrence is always safe here.
 */
const toSafeJsonLd = (value: unknown): string => JSON.stringify(value).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImagePath ? title : `${SITE.name} — ${SITE.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    {SITE.cloudflareAnalyticsToken && <link rel="preconnect" href="https://static.cloudflareinsights.com" />}

    {
      schema.map((entry) => (
        <script
          type="application/ld+json"
          is:inline
          set:html={toSafeJsonLd(entry)}
        />
      ))
    }

    {/*
      Applies the saved theme before first paint so there is no flash of the wrong
      theme. Deliberately inline and synchronous — it is a handful of bytes and must
      run before the body renders.
    */}
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') {
            document.documentElement.setAttribute('data-theme', saved);
          }
        } catch (e) {
          /* localStorage unavailable (private mode); fall back to prefers-color-scheme */
        }
      })();
    </script>

    {/*
      Sets whether the sidebar starts open or closed before first paint, so it never
      flashes from one state to the other (a layout-affecting element changing size
      after paint would be a CLS bug). Below the 64rem breakpoint the sidebar is an
      off-canvas overlay that covers the page — it always starts closed there,
      regardless of any remembered preference, so a returning small-screen visitor
      never lands on a page with the drawer already covering it. At and above
      64rem it shares space instead of covering anything, so a remembered explicit
      choice (from the toggle) is respected there; otherwise it defaults open.
    */}
    <script is:inline>
      (function () {
        var wide = window.matchMedia('(min-width: 64rem)').matches;
        if (!wide) {
          document.documentElement.setAttribute('data-sidebar', 'closed');
          return;
        }
        try {
          var saved = localStorage.getItem('sidebarOpen');
          if (saved === '1' || saved === '0') {
            document.documentElement.setAttribute('data-sidebar', saved === '1' ? 'open' : 'closed');
            return;
          }
        } catch (e) {
          /* localStorage unavailable (private mode); fall back to the default below */
        }
        document.documentElement.setAttribute('data-sidebar', 'open');
      })();
    </script>

    {
      SITE.cloudflareAnalyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${SITE.cloudflareAnalyticsToken}"}`}
        />
      )
    }
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <div class="shell">
      <ToolsSidebar />
      <main id="main" class="shell__main">
        <slot />
        <BuyMeACoffee />
      </main>
    </div>
    <Footer />
  </body>
</html>

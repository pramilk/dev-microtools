---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/site';
import { TOOL_ICONS, DEFAULT_TOOL_ICON } from '../lib/toolIcons';
import { AI_POWERED_TOOL_SLUGS } from '../lib/aiTools';
import { CATEGORIES } from '../lib/categories';

const tools = (await getCollection('tools')).sort((a, b) => a.data.order - b.data.order);

// Group by category so the index has structure rather than being one long list.
// Section order comes from CATEGORIES, not tool.order — those only sort tools within
// a category, not the categories themselves.
const categories = CATEGORIES.filter((category) => tools.some((tool) => tool.data.category === category));

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
    description: SITE.description,
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: `${SITE.url}/?q={search_term_str}`,
      },
      'query-input': 'required name=search_term_str',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: tools.map((tool, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: tool.data.title,
      url: new URL(`/${tool.id}/`, Astro.site ?? SITE.url).href,
    })),
  },
];
---

<BaseLayout
  title="Free Developer Tools & Utilities"
  description={SITE.description}
  canonicalPath="/"
  schema={schema}
  hideSidebar
>
  <div class="container home">
    <section class="hero">
      <p class="eyebrow">{tools.length} tools · no sign-up · no uploads</p>
      <h1>{SITE.tagline}</h1>
      <p class="punchline">By developers, for developers.</p>
      <p class="lede">
        Small, focused utilities for everyday development work — formatting, decoding,
        hashing, comparing. Every one runs entirely in your browser, so nothing you paste
        is ever sent to a server.
      </p>
    </section>

    <section class="finder" aria-label="Find a tool">
      <div class="finder__search">
        <label class="sr-only" for="home-search">Search tools</label>
        <input
          type="search"
          id="home-search"
          class="finder__search-input"
          placeholder="Search tools…"
          autocomplete="off"
          autofocus
          data-home-search
        />
        <kbd class="finder__search-kbd" aria-hidden="true" data-home-search-kbd>Ctrl K</kbd>
        <button
          type="button"
          class="finder__search-clear"
          data-home-search-clear
          aria-label="Clear search"
          title="Clear search"
        >
          ×
        </button>
      </div>
      <div class="finder__categories" data-home-category-filter role="group" aria-label="Filter by category">
        <button type="button" class="finder__chip" data-category="all" aria-pressed="true">All</button>
        {
          categories.map((category) => (
            <button type="button" class="finder__chip" data-category={category} aria-pressed="false">
              {category}
            </button>
          ))
        }
      </div>
    </section>

    <section class="pinned" data-pinned-section hidden aria-label="Pinned tools">
      <h2 class="group__title">Pinned</h2>
      <ul class="grid" data-pinned-list></ul>
    </section>

    {
      categories.map((category) => (
        <section class="group" data-category-section={category}>
          <h2 class="group__title">{category}</h2>
          <ul class="grid">
            {tools
              .filter((tool) => tool.data.category === category)
              .map((tool) => (
                <li
                  data-home-tool
                  data-tool-id={tool.id}
                  data-tool-name={tool.data.title.toLowerCase()}
                  data-tool-summary={tool.data.summary.toLowerCase()}
                  data-tool-category={category}
                >
                  <a href={`/${tool.id}/`} class="card tool-card">
                    <span class="tool-card__top">
                      <span class="tool-card__icon" aria-hidden="true">{TOOL_ICONS[tool.id] ?? DEFAULT_TOOL_ICON}</span>
                      <span class="tool-card__name">{tool.data.title}</span>
                    </span>
                    <span class="tool-card__summary">{tool.data.summary}</span>
                  </a>
                  {AI_POWERED_TOOL_SLUGS.has(tool.id) && (
                    <span class="tool-card__ai-badge" title="Uses an on-device AI model — still runs entirely in your browser">
                      AI
                    </span>
                  )}
                  <button
                    type="button"
                    class="tool-card__pin"
                    data-pin-toggle
                    data-tool-id={tool.id}
                    data-tool-title={tool.data.title}
                    aria-pressed="false"
                    aria-label={`Pin ${tool.data.title} to the top`}
                    title="Pin to top"
                  >
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <circle cx="12" cy="7" r="4.5" />
                      <path d="M12 11 15 20 9 20Z" />
                    </svg>
                  </button>
                </li>
              ))}
          </ul>
        </section>
      ))
    }

    <p class="finder__empty" data-home-empty hidden>No tools match your search.</p>

    <section class="why">
      <h2>Why these tools are different</h2>
      <div class="why__grid">
        <div class="why__item">
          <h3>Nothing leaves your browser</h3>
          <p>
            Every tool is pure client-side JavaScript. There is no backend and no database,
            so pasting a JWT, an API response or a config file here does not transmit it
            anywhere. Open your browser's Network tab and check — you will see no requests.
          </p>
        </div>
        <div class="why__item">
          <h3>Fast, because there is nothing to load</h3>
          <p>
            Pages are static HTML with one small interactive component. No framework
            bundle, no tracking scripts, no cookie wall between you and the thing you came
            to do.
          </p>
        </div>
        <div class="why__item">
          <h3>No sign-up, no limits</h3>
          <p>
            No account, no rate limit, no "upgrade to process files over 1MB". These are
            small utilities and they should just work.
          </p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .home {
    padding-block: var(--space-7) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
  }

  .hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 46rem;
  }

  .punchline {
    font-weight: 650;
    color: var(--accent);
    font-size: var(--text-lg);
  }

  .finder {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .finder__search {
    position: relative;
    max-width: 28rem;
  }

  .finder__search-input {
    width: 100%;
    height: 2.75rem;
    padding-inline: var(--space-4) 3.25rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    font-size: var(--text-base);
    font-family: inherit;
  }

  .finder__search-input:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 1px;
  }

  .finder__search-input::placeholder {
    color: var(--text-subtle);
  }

  /* The native clear "x" a `type="search"` input draws on its own can't be
     repositioned, resized or given a hover state, and renders inconsistently across
     browsers — so it's suppressed here and replaced with `.finder__search-clear`,
     a real button styled like the rest of the site's icon controls. */
  .finder__search-input::-webkit-search-decoration,
  .finder__search-input::-webkit-search-cancel-button,
  .finder__search-input::-webkit-search-results-button,
  .finder__search-input::-webkit-search-results-decoration {
    appearance: none;
  }

  /* Hidden once the input has a query — the shortcut has already done its job, and
     the clear button (below) takes its place once there's something to clear. */
  .finder__search-kbd {
    position: absolute;
    top: 50%;
    right: var(--space-3);
    transform: translateY(-50%);
    padding: 0.15rem 0.4rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    color: var(--text-subtle);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1.3;
    pointer-events: none;
    white-space: nowrap;
  }

  .finder__search-input:focus ~ .finder__search-kbd,
  .finder__search-input:not(:placeholder-shown) ~ .finder__search-kbd {
    display: none;
  }

  .finder__search-clear {
    display: none;
    align-items: center;
    justify-content: center;
    position: absolute;
    top: 50%;
    right: 0.3rem;
    transform: translateY(-50%);
    width: 2.1rem;
    height: 2.1rem;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: transparent;
    color: var(--text-subtle);
    cursor: pointer;
    font-size: 1.2rem;
    line-height: 1;
    transition:
      background-color 0.12s ease,
      color 0.12s ease;
  }

  .finder__search-clear:hover {
    background: var(--surface-2);
    color: var(--text);
  }

  .finder__search-clear:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 1px;
  }

  .finder__search-input:not(:placeholder-shown) ~ .finder__search-clear {
    display: inline-flex;
  }

  .finder__categories {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .finder__chip {
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-weight: 550;
    cursor: pointer;
    transition:
      background-color 0.12s ease,
      border-color 0.12s ease,
      color 0.12s ease;
  }

  .finder__chip:hover {
    border-color: var(--accent-border);
    color: var(--text);
  }

  .finder__chip[aria-pressed='true'] {
    background: var(--accent-subtle);
    border-color: var(--accent);
    color: var(--accent);
  }

  .finder__empty {
    color: var(--text-subtle);
    font-size: var(--text-sm);
    text-align: center;
    padding-block: var(--space-6);
  }

  .group__title {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-family: var(--font-mono);
    color: var(--text-subtle);
    font-weight: 600;
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border);
    margin-bottom: var(--space-4);
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
  }

  /* Anchors the pin button (below), which overlays a card's own corner rather than
     taking up grid space of its own. */
  .grid > li {
    position: relative;
  }

  .tool-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-4);
    text-decoration: none;
    transition:
      border-color 0.12s ease,
      transform 0.12s ease,
      box-shadow 0.12s ease;
  }

  .tool-card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow);
  }

  .tool-card__top {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    /* Clears the pin button overlaid in the card's corner (below) so a long tool name
       never runs underneath it. */
    padding-right: 1.75rem;
  }

  .tool-card__pin {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: transparent;
    color: var(--text-subtle);
    cursor: pointer;
    opacity: 0.5;
    transition:
      opacity 0.12s ease,
      background-color 0.12s ease,
      color 0.12s ease;
  }

  .tool-card__pin:hover,
  .tool-card__pin:focus-visible {
    opacity: 1;
    background: var(--surface-2);
  }

  .tool-card__pin:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 1px;
  }

  .tool-card__pin[aria-pressed='true'] {
    opacity: 1;
    color: var(--accent);
  }

  .tool-card__pin svg {
    width: 0.85rem;
    height: 0.85rem;
    fill: currentColor;
    /* Diagonal, as if laid flat and not yet pushed in — rotates upright (below) once
       pinned, the same "stuck in" motion browser tab-pin and Notion-style pin toggles
       use, so the icon itself carries the state change, not just its colour. */
    transform: rotate(45deg);
    transition: transform 0.15s ease;
  }

  .tool-card__pin[aria-pressed='true'] svg {
    transform: rotate(0deg);
  }

  /* Colour alone, no filled badge chip — a first pass used a solid background here
     and it read as too heavy next to the card's plain-text name/summary. */
  .tool-card__icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    min-width: 2.1rem;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    opacity: 0.85;
    transition: opacity 0.12s ease;
  }

  .tool-card:hover .tool-card__icon {
    opacity: 1;
  }

  .tool-card__name {
    font-weight: 650;
    color: var(--text);
    font-size: var(--text-base);
  }

  /* Outlined, not filled — the same restraint as .tool-card__icon just above (a first pass
     there used a solid background and it read as too heavy next to the card's plain-text
     name/summary; a filled chip here would repeat that mistake). Absolutely positioned in
     the card's own corner (the same technique .tool-card__pin uses for its corner, anchored
     by `.grid > li { position: relative }` above) rather than sitting inline next to the
     name — inline, it competed with the title for width and could force a longer tool name
     onto two lines only on cards that happen to use AI, an inconsistency worth avoiding
     entirely rather than trying to make just wide enough. */
  .tool-card__ai-badge {
    position: absolute;
    bottom: var(--space-3);
    right: var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--accent);
    background: var(--surface);
    border: 1px solid var(--accent);
    border-radius: var(--radius-sm);
    padding: 0.05rem 0.3rem;
    opacity: 0.8;
    pointer-events: none;
  }

  .tool-card:hover .tool-card__ai-badge {
    opacity: 1;
  }

  .tool-card:hover .tool-card__name {
    color: var(--accent);
  }

  .tool-card__summary {
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.5;
  }

  .why {
    border-top: 1px solid var(--border);
    padding-top: var(--space-6);
  }

  .why h2 {
    margin-bottom: var(--space-4);
  }

  .why__grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
  }

  .why__item h3 {
    font-size: var(--text-base);
    margin-bottom: var(--space-2);
  }

  .why__item p {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
</style>

<script>
  // The behaviour lives in src/lib/homeFilter.ts and src/lib/pinnedTools.ts so it can be
  // unit-tested; an inline <script> in a .astro file has no test harness. This file
  // keeps the markup.
  import { initHomeFilter } from '../lib/homeFilter';
  import { initPinnedTools } from '../lib/pinnedTools';

  initHomeFilter();
  initPinnedTools();
</script>

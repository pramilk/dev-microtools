  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/optimize-images.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",

# Cloudflare Workers static-assets / Pages header convention (same directory as _redirects).
# Applies to every route on the site — see CLAUDE.md's "site must be fast" / no-backend
# rules for context: this is a fully static, client-side-only site, so these headers are
# about hardening the browser sandbox around the tools, not protecting a server.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  # script-src/style-src need 'unsafe-inline': the theme-toggle/sidebar scripts use Astro's
  # `is:inline` (no build-time nonce to attach), and many islands set inline `style="..."`
  # for values computed at runtime (e.g. QR/color-picker previews) — both would break under
  # a strict CSP without a nonce/hash pipeline, which is a larger follow-up, not this pass.
  # connect-src allows any https: origin because two tools are *supposed* to reach arbitrary
  # user-specified endpoints (Curl Command Builder sends to whatever URL the user types; the
  # npm Package Size tool queries the npm registry/esm.sh) — locking connect-src to 'self'
  # would break both by design, not as an oversight.
  # script-src additionally allows static.cloudflareinsights.com for Cloudflare Web
  # Analytics' beacon script (loaded in BaseLayout.astro when SITE.cloudflareAnalyticsToken
  # is set) — without it the browser blocks the beacon and analytics silently stop recording.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'

# Background Remover and Face & Plate Blur are the two pages on the site that run
# WebAssembly (onnxruntime-web, for their in-browser AI models) — WASM instantiation needs
# 'wasm-unsafe-eval' in script-src, a narrow keyword that permits WebAssembly.compile/instantiate
# specifically without opening up 'unsafe-eval's full arbitrary-string-eval surface.
#
# IMPORTANT: Cloudflare's _headers does NOT let a more specific rule override a header set by
# a broader one — when multiple sections match the same path, same-named header VALUES ARE
# JOINED WITH A COMMA (https://developers.cloudflare.com/workers/static-assets/headers/),
# which silently mangles a second Content-Security-Policy into garbage rather than replacing
# the first. Since every path (including this one) also matches the site-wide "/*" block
# above, EVERY header this block also sets needs its own "! HeaderName" line first to detach
# the inherited copy — otherwise the response carries the header twice (harmless for the
# identical ones below, but still wrong, and a silent no-op for Content-Security-Policy since
# its two differing values get comma-joined into something no browser can parse correctly).
# Everything else in the policy is identical to the default above; keep the two in sync if
# the shared policy ever changes. Any future WASM-backed tool needs the same block added here.
/background-remover/
  ! X-Content-Type-Options
  ! X-Frame-Options
  ! Referrer-Policy
  ! Permissions-Policy
  ! Strict-Transport-Security
  ! Content-Security-Policy
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'

/face-plate-blur/
  ! X-Content-Type-Options
  ! X-Frame-Options
  ! Referrer-Policy
  ! Permissions-Policy
  ! Strict-Transport-Security
  ! Content-Security-Policy
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'

# Build-output JS/CSS/wasm chunks (Astro emits them all here, regardless of which page(s)
# import them) must NOT carry their own Content-Security-Policy header. These files are
# never navigated to directly, so a CSP on the asset response itself is normally a no-op —
# except when a script here is loaded as a dedicated Worker (as onnxruntime-web does for its
# threaded WASM backend, used by Background Remover and Face & Plate Blur): per the CSP spec, a same-origin worker
# inherits its CREATING DOCUMENT's policy only if the worker script's own HTTP response has
# no explicit Content-Security-Policy header. Because the site-wide "/*" rule above sets one
# on every response, /_astro/ort.wasm.bundle*.js was carrying the SITE-WIDE DEFAULT policy
# (no 'wasm-unsafe-eval') and the worker enforced that instead of inheriting
# /background-remover/'s correct one — silently breaking WASM instantiation regardless of
# what the *page's* CSP said, and regardless of caching. Removing the header here (rather
# than trying to special-case one chunk's filename, which is hashed and changes every build)
# fixes this for any current or future worker-based library, with no security loss: these
# files were never meaningfully protected by their own CSP header in the first place.
/_astro/*
  ! Content-Security-Policy
